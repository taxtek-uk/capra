# Copy to .env.local and fill in. .env* is gitignored: never commit a real value.
# On Vercel: `vercel link && vercel env pull .env.local`.

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Orders, accounts, admin, analytics and rate limits. Without it the storefront still renders,
# but checkout answers "WhatsApp us to order". Apply the schema: node scripts/apply-schema.mjs
CAPRA_DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# ─── /admin ──────────────────────────────────────────────────────────────────
# Signs the admin session cookie and salts the visit IP hash. Not a password: sign-in is
# email + password against site_admins (seed with scripts/seed-admin-user.mjs).
ADMIN_DASH_TOKEN=a-long-random-string

# ─── Customer links and accounts ─────────────────────────────────────────────
# Signs every order-page link (/order/<ref>?k=…), the customer sign-in cookie and code hashes.
# REQUIRED: without it no customer can open their order page and accounts are off.
# Use a different value from ADMIN_DASH_TOKEN. Rotating it breaks every order link already sent.
CUSTOMER_SESSION_SECRET=a-different-long-random-string

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Verify capra.pk in Resend first. TO_EMAIL receives every order and enquiry.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="CAPRA <info@capra.pk>"
TO_EMAIL=info@capra.pk
SEND_CUSTOMER_COPY=true
# BCC_EMAIL=
# Set to 1 locally so exercising the APIs logs the email instead of sending it.
EMAIL_DRY_RUN=1

# ─── Cron ────────────────────────────────────────────────────────────────────
# /api/cron/daily (basket reminders and clean-up) refuses to run without it.
CRON_SECRET=another-long-random-string
